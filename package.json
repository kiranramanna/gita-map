{
  "name": "gita-map",
  "version": "0.1.0",
  "private": true,
  "description": "Gita Map: a source-grounded study companion for the Advaita Retold Bhagavad Gita lecture series (static site).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --config site/vite.config.js",
    "build": "npm run check && vite build --config site/vite.config.js",
    "preview": "vite preview --config site/vite.config.js",
    "check": "node site/scripts/check-data.mjs",
    "serve:subpath": "node site/scripts/serve-subpath.mjs",
    "test:e2e": "node site/e2e/smoke.mjs"
  },
  "dependencies": {
    "3d-force-graph": "1.80.1",
    "cytoscape": "^3.34.4",
    "mermaid": "^11.17.2",
    "three": "0.186.1",
    "three-spritetext": "1.10.0"
  },
  "devDependencies": {
    "playwright": "^1.65.0",
    "vite": "^7.3.7"
  }
}
